# Local Python environments and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]

# Local research tools, internal state, and downloaded research output.
/.research-dev/
/.frankensurf-state/
/research/

# Test and analysis caches, coverage output, and runtime logs.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

.agents

# Local secrets; example configuration files can still be committed.
.env
.env.*
!.env.example
!.env.template
**/.streamlit/secrets.toml

# Keep generated SearXNG files out of Git, but retain its shared settings.
/searxng/*
!/searxng/settings.yml
